# Local Docker defaults only. Replace every secret outside local development.
POSTGRES_DB=gameio
POSTGRES_USER=gameio
POSTGRES_PASSWORD=gameio_dev_password
JWT_SECRET=replace-with-at-least-64-random-characters-before-any-real-deployment
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Optional host-port overrides when 8080 or 3000 is already in use.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# URLs embedded in the browser bundle.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Server-side origin used by the frontend BFF; never exposed to the browser.
BACKEND_ORIGIN=http://backend:8080

# Comma-separated browser origins accepted by the backend.
CORS_ALLOWED_ORIGINS=http://localhost:3000
